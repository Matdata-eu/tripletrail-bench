QUERY 0 - Thematic_Search:

PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
PREFIX geonames: <http://www.geonames.org/ontology#>

SELECT ?f ?name ?geo ?wkt 
WHERE { 
   GRAPH <http://geographica.di.uoa.gr/dataset/geonames> { 
      ?f geonames:name ?name;
         <http://www.geonames.org/ontology#hasGeometry> ?geo.
	   ?geo <http://www.geonames.org/ontology#asWKT> ?wkt.
      FILTER(?name = "Tális"^^xsd:string) 
   }
}


QUERY 1 - Get_Around_POIs:

PREFIX geof: <http://www.opengis.net/def/function/geosparql/>
PREFIX geonames: <http://www.geonames.org/ontology#>

SELECT ?f ?name ?fGeo ?code ?parent ?class ?fGeoWKT 
WHERE { 
   GRAPH <http://geographica.di.uoa.gr/dataset/geonames> { 
      ?f geonames:name ?name; 
         <http://www.geonames.org/ontology#hasGeometry> ?fGeo; 
         geonames:featureCode ?code;  
         geonames:parentFeature ?parent; 
         geonames:featureClass ?class. 
      ?fGeo <http://www.geonames.org/ontology#asWKT> ?fGeoWKT. 
      FILTER(geof:sfIntersects(?fGeoWKT, "null"^^<http://www.opengis.net/ont/geosparql#wktLiteral>)).
   }
} 


QUERY 2 - Get_Around_Roads:
 
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> 
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX geof: <http://www.opengis.net/def/function/geosparql/>

SELECT ?r ?type ?label ?rGeo ?rGeoWKT 
WHERE { 
   GRAPH <http://geographica.di.uoa.gr/dataset/lgd> { 
      ?r rdf:type ?type. 
	   OPTIONAL{ ?r rdfs:label ?label }. 
	   ?r <http://linkedgeodata.org/ontology/hasGeometry> ?rGeo. 
	   ?rGeo <http://linkedgeodata.org/ontology/asWKT> ?rGeoWKT. 
      FILTER(geof:sfIntersects(?rGeoWKT, "null"^^<http://www.opengis.net/ont/geosparql#wktLiteral>)).
   } 
}