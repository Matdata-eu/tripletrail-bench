PREFIX spatialSearch: <https://qlever.cs.uni-freiburg.de/spatialSearch/>
# stand-in for the OSM<->RINF 5 m conflation join; libspatialjoin within-distance join
SELECT (COUNT(*) AS ?n) WHERE {
  ?t1 a bench:OsmTrack ; geo:hasGeometry/geo:asWKT ?w1 .
  SERVICE spatialSearch: {
    _:c spatialSearch:algorithm spatialSearch:libspatialjoin ; spatialSearch:left ?w1 ; spatialSearch:right ?w2 ;
        spatialSearch:joinType spatialSearch:within-dist ; spatialSearch:maxDistance 5 ; spatialSearch:payload ?t2 .
    { ?t2 a bench:OsmTrack ; geo:hasGeometry/geo:asWKT ?w2 }
  }
  FILTER(?t1 != ?t2)
}
