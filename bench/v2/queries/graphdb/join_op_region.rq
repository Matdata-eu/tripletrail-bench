# The triple form (?g1 geo:sfWithin|sfIntersects ?g2, GraphDB's indexed form) was tried on
# osm_benelux (run 44998055578) and also hit the 600 s limit; this FILTER form is the one whose
# answers are checked against the reference.
SELECT ?r (COUNT(?o) AS ?n) WHERE {
  ?o a era:OperationalPoint ; geo:hasGeometry/geo:asWKT ?w1 .
  ?r a bench:Region ; geo:hasGeometry/geo:asWKT ?w2 .
  FILTER(geof:sfWithin(?w1, ?w2))
} GROUP BY ?r
