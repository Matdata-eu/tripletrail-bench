# GraphDB GeoSPARQL plugin: the triple form between two geometries uses its spatial index
# (FILTER(geof:sfIntersects(...)) is evaluated pair by pair)
SELECT (COUNT(*) AS ?n) WHERE {
  ?t a bench:OsmTrack ; geo:hasGeometry ?g1 .
  ?g1 geo:sfIntersects ?g2 .
  ?l a bench:OsmLanduse ; geo:hasGeometry ?g2 .
}
